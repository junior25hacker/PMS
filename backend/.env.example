# ---------------------------------------------------------------------------
# Pharmly API — environment template.  Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Database Engine: 'sqlite' (local development) or 'postgres' (Render / cloud)
# On Render, DATABASE_URL is provided automatically from the PostgreSQL service.
DB_TYPE=sqlite
# DATABASE_URL=postgres://user:password@host:5432/pharmly

# PostgreSQL Settings (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pharmly
DB_SYNCHRONIZE=true
DB_LOGGING=false
# DB_SSL=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-too-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Business rules
DEFAULT_TAX_RATE=0.12
LOW_STOCK_THRESHOLD=20
EXPIRY_ALERT_DAYS=90
